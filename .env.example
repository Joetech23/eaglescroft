# Public site URL (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=https://eaglescroft.com.ng

# Optional: Calendly booking link shown on the contact page
NEXT_PUBLIC_CALENDLY_URL=

# Google Search Console verification (Settings → Ownership verification → HTML tag content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Client portal (/portal, /admin) ─────────────────────────────────────────
# Leave these blank and /portal shows a "launching soon" page; the marketing site is unaffected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (card/bank payments for invoices). Webhook URL: https://eaglescroft.com.ng/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# Google Business Profile "write a review" short link, shown on a completed project's final review
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
