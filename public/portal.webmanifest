{
  "name": "Eaglescroft Portal",
  "short_name": "Eaglescroft",
  "description": "Your Eaglescroft projects, messages, tasks, meetings and invoices in one place.",
  "id": "/portal",
  "start_url": "/portal?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f4f6fb",
  "theme_color": "#001e60",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Messages", "url": "/portal/messages", "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "/portal/tasks", "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192" }] },
    { "name": "Book a meeting", "url": "/portal/meetings/book", "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192" }] }
  ]
}
